# Linux-only keybinds (mirrors platform-macos.ghostty).
# NOTE: `option`/`cmd` modifiers do not exist on Linux — a `global:option+…`
# trigger is silently ignored, which is why the quick terminal never fired.
# NOTE 2: even with a valid trigger, `global:` needs the GlobalShortcuts
# portal handshake (permission dialog). On Hyprland that dialog never
# appears, so the bind stays local-only (works just with Ghostty focused).
# Robust path: Hyprland bind -> `ghostty +toggle-quick-terminal` (native
# IPC/D-Bus, no portal). See keybindings/default.lua (SUPER+grave).
# keybind = global:alt+space=toggle_quick_terminal

# Persistence: stay visible across window switches until toggled again.
quick-terminal-autohide = false
