# ── Quick Terminal ────────────────────────────────────────────
# Activa desde cualquier app (requiere permisos Accesibilidad)
keybind = global:alt+space=toggle_quick_terminal

# ── Splits ───────────────────────────────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+[=goto_split:previous
keybind = cmd+shift+]=goto_split:next

# ── Tabs ─────────────────────────────────────────────────────
keybind = cmd+t=new_tab
keybind = cmd+w=close_tab
keybind = cmd+shift+h=previous_tab
keybind = cmd+shift+l=next_tab

# ── Font size (útil en presentaciones o pair programming) ─────
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# ── Navegación de prompts (shell integration requerida) ───────
keybind = cmd+up=jump_to_prompt:-1
keybind = cmd+down=jump_to_prompt:1

# ── Misceláneos ───────────────────────────────────────────────
keybind = cmd+shift+comma=reload_config
keybind = cmd+shift+p=toggle_command_palette
